
<% content = (@contactpages.content || {}) %>
<% contact = content["contact_form"] || {} %>
<% address = content["address"] || {} %>
<% call_center = content["call_center"] || {} %>
<% electronic = content["electronic_support"] || {} %>
<div class="page-head">
  <div class="container">
    <div class="row">
      <div class="page-head-content">
        <h1 class="page-title"><%= @contactpages.title %></h1>
      </div>
    </div>
  </div>
</div>

<div class="content-area recent-property padding-top-40" style="background-color:#FFF;">
<div class="container">

<div class="row">
<div class="col-md-8 col-md-offset-2">

<div id="contact1">
<div class="row">

<!-- Address -->
<div class="col-sm-4">
<h3>
<i class="fa fa-map-marker"></i>
<%= address["label"] %>
</h3>

<p>
<%= simple_format(address["value"]) %>
</p>
</div>


<!-- Call Center -->
<div class="col-sm-4">

<h3>
<i class="fa fa-phone"></i>
<%= call_center["label"] %>
</h3>

<p class="text-muted">
<%= call_center["description"] %>
</p>

<p>
<strong><%= call_center["number"] %></strong>
</p>

</div>


<!-- Electronic Support -->
<div class="col-sm-4">

<h3>
<i class="fa fa-envelope"></i>
<%= electronic["label"] %>
</h3>

<p class="text-muted">
<%= electronic["description"] %>
</p>

<ul>
<li>
<strong>
<%= mail_to electronic["email"] %>
</strong>
</li>
</ul>

</div>

</div>

<hr>

<h2><%= contact["title"] %></h2>
<%= form_with model: Contact.new, url: pages_contact_path, local: true do |f| %>
<%# <%= form_with url: pages_contact_path, method: :post, local: true do |f| %> 

<div class="row">

<div class="col-sm-6">
<div class="form-group">
<%= f.label :firstname, contact["firstname"] %>
<%= f.text_field :firstname, class:"form-control" %>
</div>
</div>

<div class="col-sm-6">
<div class="form-group">
<%= f.label :lastname, contact["lastname"] %>
<%= f.text_field :lastname, class:"form-control" %>
</div>
</div>

<div class="col-sm-6">
<div class="form-group">
<%= f.label :email, contact["email"] %>
<%= f.text_field :email, class:"form-control" %>
</div>
</div>

<div class="col-sm-6">
<div class="form-group">
<%= f.label :subject, contact["subject"] %>
<%= f.text_field :subject, class:"form-control" %>
</div>
</div>

<div class="col-sm-12">
<div class="form-group">
<%= f.label :message, contact["message"] %>
<%= f.text_area :message, class:"form-control" %>
</div>
</div>

<div class="col-sm-12 text-center">
<button class="btn btn-primary">
<i class="fa fa-envelope-o"></i>
<%= contact["button"] %>
</button>
</div>

</div>

<% end %>

</div>
</div>
</div>
</div>
</div>