<div class="slider-area">
    <% if @banner.present? %>
        <div class="slider">
            <div id="bg-slider" class="owl-carousel owl-theme">
                
        
                    <% if @banner&.images&.attached? %>
                        <% @banner.images.each do |img| %>
                            <div class="item">
                            <%= image_tag img %>
                            </div>
                        <% end %>
                    <%else%>
                        <div class="item">
                            <%= image_tag("slide1/slider-image-1.jpg") %>
                        </div>

                        <div class="item">
                            <%= image_tag("slide1/slider-image-2.jpg") %>
                        </div>

                        <div class="item">
                            <%= image_tag("slide1/slider-image-4.jpg") %>
                        </div>
                            
                    <%end%>
                

            </div>
        </div>
        <div class="slider-content">
            <div class="row">
                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1 col-sm-12">
                    <h2><%=@banner.title%></h2>
                    
                    <p><%=@banner.subtitle%></p>
                    <div class="search-form wow pulse" data-wow-delay="0.8s">
                        <%= search_form_for @q, url: root_path, method: :get, remote: true,html: { data: { turbo: false,type: :script },class: "form-inline" } do |f|  %>
                
                    <%# <%= form_with url: root_path, method: :get, html: { class: "form-inline" }, remote: true do |f| %> 
                    <%= render "homebanersearch", f: f  %>
                    <% end %>
                    </div>
                </div>
            </div>
        </div>

        
    <%end%>
</div>

<div id="quick-properties">

  <%= render 'properties_list', properties: @properties %>
</div>


<!-- property area -->
<div class="content-area home-area-1 recent-property" style="background-color: #FCFCFC; padding-bottom: 55px;">
     <% if @featured_properties.present? %>
            <div class="container">

                <div class="row">
                    <div class="col-md-10 col-md-offset-1 col-sm-12 text-center page-title">
                        <% if @featured_section&.title.present? %>
                        <h2><%= @featured_section.title %></h2>
                        <% else %>
                        <h2>Top submitted property</h2>
                        <% end %>

                        <% if @featured_section&.subtitle.present? %>
                        <p><%= @featured_section.subtitle %></p>
                        <% else %>
                        <p>Nulla quis dapibus nisl. Suspendisse ultricies commodo arcu nec pretium.</p>
                        <% end %>
                    </div>
                </div>

                <div class="row">
                    <div class="proerty-th">

                        <% if @featured_properties.present? %>
                            <% @featured_properties.each do |property| %>
                                <div class="col-sm-6 col-md-3 p0">
                                    <div class="box-two proerty-item indprop">

                                        <div class="item-thumb">
                                            <%= link_to property_path(property) do %>

                                                <% if property.images.attached? %>
                                                    <%= image_tag property.images.first.variant(resize_to_fill: [260, 180]),
                                                        class: "img-responsive",
                                                        alt: property.name %>
                                                <% else %>
                                                    <%= image_tag "demo/property-1.jpg",
                                                        class: "img-responsive",
                                                        alt: "No Image" %>
                                                <% end %>

                                            <% end %>
                                        </div>

                                        <div class="item-entry overflow">
                                            <h5>
                                                <%= link_to property.name, property_path(property) %>
                                            </h5>

                                            <div class="dot-hr"></div>

                                            <span class="pull-left">                                        
                                                <b>Area :</b><%= property.area %></span>                                    <span class="proerty-price pull-right">
                                                $<%= property.price %>
                                            </span>
                                        </div>

                                    </div>
                                </div>
                            <% end %>
                        <% else %>                    <div class="col-md-12 text-center">                        <p>No featured properties yet. <strong><%= link_to "View all properties", properties_path %></strong></p>                    </div>                <% end %>

                        <!-- Show all properties -->
                        <div class="col-sm-6 col-md-3 p0">
                            <div class="box-tree more-proerty text-center">
                                <div class="item-tree-icon">
                                    <i class="fa fa-th"></i>
                                </div>                        <div class="more-entry overflow">                            <h5><%= link_to "CAN'T DECIDE ?", properties_path %></h5>                            <h5 class="tree-sub-ttl">Show all properties</h5>                        <%= link_to "All properties",
                                    properties_path,
                                    class: "btn border-btn more-black" %>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    <%end%>
</div>

