<div class="container" style="margin-top:40px;">
  <div class="panel panel-default">

    <div class="panel-heading clearfix">
          <h3 class="panel-title pull-left">
            <strong>Section:</strong> <%= @section.section_type.humanize %>
          </h3>

          <% if logged_in? && current_user.admin? %>
            <div class="pull-right">
              <%= link_to edit_managesection_path(@section), class: "btn btn-warning btn-xs" do %>
                <i class="fa fa-edit"></i> Edit
              <% end %>

              <%= link_to "Back", managesections_path, class: "btn btn-default btn-xs" %>
            </div>
          <% end %>
        </div>

    <div class="panel-body">
       
        
            
      <div class="row">
        <div class="col-md-12">
          <h2><%= @section.content["heading"] %></h2>
          <h3 class="text-primary"><%= @section.title %></h3>
          <p class="text-muted"><%= @section.subtitle %></p>
        </div>
      </div>

      <hr>

      <h4><strong>Featured Properties</strong></h4>

      <div class="row">
        <% if @section.content["featured_property_ids"].present? %>
          <% Property.where(id: @section.content["featured_property_ids"]).each do |property| %>

            <div class="col-md-4">
              <div class="panel panel-info">
                <div class="panel-body text-center">
                    
                  <h4><%= link_to property.name, property_path(property)  %></h4>
                </div>
              </div>
            </div>

          <% end %>
        <% else %>
          <p class="text-muted">No featured properties selected.</p>
        <% end %>
      </div>

    </div>

    

  </div>
</div>