


<div class="container" style="margin-top:40px;">
  <div class="row">
    <div class="col-md-10 col-md-offset-1">

      <div class="panel panel-default">

        <!-- Panel Heading -->
        <div class="panel-heading clearfix">
          <h3 class="panel-title pull-left">
            <strong>Section:</strong> <%= @section.section_type.humanize %>
          </h3>

          <% if logged_in? && current_user.admin? %>
            <div class="pull-right">
              <%= link_to edit_managesection_path(@section), class: "btn btn-warning btn-xs" do %>
                <i class="fa fa-edit"></i> Edit
              <% end %>

              <%= link_to "Back", managesections_path, class: "btn btn-default btn-xs" %>
            </div>
          <% end %>
        </div>

        <!-- Panel Body -->
        <div class="panel-body">

          <!-- Title -->
          <div class="row" style="margin-bottom:25px;">
            <div class="col-md-3 text-right">
              <h4><strong>Section Title:</strong></h4>
            </div>
            <div class="col-md-9">
              <h3 class="text-primary text-center"><%= @section.title %></h3>
            </div>
          </div>



          <!-- Services -->
          <div class="row">
            <div class="col-md-12 text-center">
              <h3><strong>Icons & Counts</strong></h3>
              <hr>
            </div>

            <% counters = (@section.content || {})["counters"] || [] %>
            <% counters.each_value do |counter| %>
              <div class="col-sm-3 text-center" style="margin-bottom:25px;">
                <div class="panel panel-default">

                  <div class="panel-body">

                    <div style="margin-bottom:10px;">
                      <i class="<%= counter["icon"] %> pe-4x text-primary"></i>
                    </div>

                    <h4 class="text-primary"><%= counter["number"] %></h4>
                    <h4 class="text-primary"><%= counter["label"] %></h4>

                  </div>

                </div>
              </div>
            <% end %>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>
