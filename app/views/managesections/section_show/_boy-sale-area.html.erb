
<div class="container">
    
<div class="row">
    <div class="panel panel-default">
        <div class="panel-heading clearfix">
            <h3 class="panel-title pull-left">
                <strong>Section:</strong> <%= @section.section_type.humanize %>
            </h3>

            <% if logged_in? && current_user.admin? %>
                <div class="pull-right">
                <%= link_to edit_managesection_path(@section), class: "btn btn-warning btn-xs" do %>
                    <i class="fa fa-edit"></i> Edit
                <% end %>

                <%= link_to "Back", managesections_path, class: "btn btn-default btn-xs" %>
                </div>
            <% end %>
        </div>
    <% blocks = (@section.content || {})["blocks"] || {} %>

    <% blocks.each_value do |block| %>

    <div class="col-md-12 col-sm-10 col-sm-offset-1 col-md-offset-0 col-xs-12" style="margin: 40px 0px">

    <div class="asks-first">

    <div class="asks-first-circle">
    <span class="<%= block["icon1"] %>"></span>
    </div>

    <div class="asks-first-info">

    <h2><%= block["title"] %></h2>

    <p><%= block["description"] %></p>

    </div>

    <div class="asks-first-arrow">

    <%= link_to block["link"] do %>

  <span class="<%= block["icon2"] %>"></span>
<% end %>

    </div>

    </div>

    </div>

    <% end %>

    <div class="col-xs-12">
    <p class="asks-call">

    <%= @section.content["query"] %>

    <span class="strong">
    <%= @section.content["phone"] %>
    </span>

    </p>
    </div>

    </div>
    </div>
</div>
