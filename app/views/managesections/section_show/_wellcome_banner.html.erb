<% if @section.present? %>
<div class="container" style="margin-top:40px;">
  <div class="row">
    <div class="col-md-10 col-md-offset-1">

      <div class="panel panel-default">

        <!-- Panel Heading -->
        <div class="panel-heading clearfix">
          <h3 class="panel-title pull-left">
            <strong>Section:</strong> <%= @section.section_type.humanize %>
          </h3>

          <% if logged_in? && current_user.admin? %>
            <div class="pull-right">
              <%= link_to edit_managesection_path(@section), class: "btn btn-warning btn-xs" do %>
                <i class="fa fa-edit"></i> Edit
              <% end %>

              <%= link_to "Back", managesections_path, class: "btn btn-default btn-xs" %>
            </div>
          <% end %>
        </div>

        <!-- Panel Body -->
        <div class="panel-body">

          <!-- Title -->
          <div class="row" style="margin-bottom:25px;">
            <div class="col-md-3 text-right">
              <h4><strong>Section Title:</strong></h4>
            </div>
            <div class="col-md-9">
              <h3 class="text-primary text-center"><%= @section.title %></h3>
            </div>
          </div>

          <!-- Images -->
          <% if @section.images.attached? %>
          <div class="row" style="margin-bottom:30px;">
            <div class="col-md-12">
              <h4 class="text-center"><strong>Section Images</strong></h4>
              <hr>

              <div class="row">
                <% @section.images.each do |img| %>
                  <div class="col-sm-4">
                    <div class="thumbnail">
                      <%= image_tag img, class: "img-responsive", style: "height:200px; object-fit:cover; width:100%;" %>
                    </div>
                  </div>
                <% end %>
              </div>

            </div>
          </div>
          <% end %>

          <!-- Services -->
          <div class="row">
            <div class="col-md-12 text-center">
              <h3><strong>Icons & Services</strong></h3>
              <hr>
            </div>

            <% services = (@section.content || {})["services"] || {} %>

            <% services.each_value do |service| %>
              <div class="col-sm-3 text-center" style="margin-bottom:25px;">
                <div class="panel panel-default">

                  <div class="panel-body">

                    <div style="margin-bottom:10px;">
                      <i class="<%= service['icon'] %> pe-4x text-primary"></i>
                    </div>

                    <h4><%= service["title"] %></h4>

                  </div>

                </div>
              </div>
            <% end %>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>
<% end %>