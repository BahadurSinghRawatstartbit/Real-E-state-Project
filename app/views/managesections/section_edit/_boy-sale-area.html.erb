<div class="container" style="margin-top:30px;">

<div class="panel panel-primary">

<div class="panel-heading" style="display:flex;align-items:center;justify-content:space-between;">
<h3 class="panel-title">
<i class="fa fa-edit"></i> Edit Welcome Section
</h3>

<span class="pull-right">
<%= link_to "Back", managesections_path, class:"btn btn-default btn-xs" %>
</span>

</div>

<div class="panel-body">
<div class="form-group">
  <%= f.label :title, "Title" %>
  <%= f.text_field :title, class: "form-control" %>
</div>
<div class="form-group">
<%= label_tag "Query Text" %>
<%= text_field_tag "managesection[content][query]", @section.content["query"], class:"form-control" %>
</div>

<div class="form-group">
<%= label_tag "Phone Number" %>
<%= text_field_tag "managesection[content][phone]", @section.content["phone"], class:"form-control" %>
</div>

<hr>

<h4>CTA Blocks</h4>

<% 2.times do |i| %>

<% block = @section.content.dig("blocks", i.to_s) || {} %>

<div class="row border p-3 mb-3">

<div class="col-md-4">
<div class="form-group">
<%= label_tag "Icon 1" %>
<%= text_field_tag "managesection[content][blocks][#{i}][icon1]", block["icon1"], class:"form-control" %>
</div>
</div>

<div class="col-md-4">
<div class="form-group">
<%= label_tag "Icon 2" %>
<%= text_field_tag "managesection[content][blocks][#{i}][icon2]", block["icon2"], class:"form-control" %>
</div>
</div>

<div class="col-md-4">
<div class="form-group">
<%= label_tag "Title" %>
<%= text_field_tag "managesection[content][blocks][#{i}][title]", block["title"], class:"form-control" %>
</div>
</div>

</div>

<div class="row">

<div class="col-md-12">
<div class="form-group">

<label>Link</label>

<%= select_tag "managesection[content][blocks][#{i}][link]",
options_for_select([
["Properties","/properties"],
["Support","#"]
], block["link"]), class:"form-control" %>

</div>
</div>

<div class="col-md-12">
<div class="form-group">
<label>Description</label>
<%= text_area_tag "managesection[content][blocks][#{i}][description]", block["description"], class:"form-control" %>
</div>
</div>

</div>

<hr>

<% end %>

<%= f.submit "Update Section", class:"btn btn-success" %>

</div>
</div>
</div>