<div class="form-group">
  <%= f.label :title, "Title" %>
  <%= f.text_field :title, class: "form-control" %>
</div>

<div class="form-group">
  <%= label_tag "Query Text" %>
  <%= text_field_tag "managesection[content][query]", nil, class:"form-control" %>
</div>

<div class="form-group">
  <%= label_tag "Phone Number" %>
  <%= text_field_tag "managesection[content][phone]", nil, class:"form-control" %>
</div>

<hr>

<h4>CTA Blocks</h4>

<% 2.times do |i| %>

<div class="row border p-3 mb-3">

  <div class="col-md-4">
    <div class="form-group">
        <%= label_tag "Icon #{i+1}" %>
      
      <%= text_field_tag "managesection[content][blocks][#{i}][icon1]", nil, class:"form-control" %>
    </div>
  </div>
  <div class="col-md-4">
    <div class="form-group">
      <%= label_tag "Icon #{i+1}" %>
      <%= text_field_tag "managesection[content][blocks][#{i}][icon2]", nil, class:"form-control" %>
    </div>
  </div>

  <div class="col-md-4">
    <div class="form-group">
      <label>Title</label>
      <%= text_field_tag "managesection[content][blocks][#{i}][title]", nil, class:"form-control" %>
    </div>
  </div>

  

</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group">
<label>Link </label>


<%= select_tag "managesection[content][blocks][#{i}][link_type]",
options_for_select([
["Properties","/properties"],
["Support","#"],

]), class:"form-control link-", data:{index:i} %>

</div>
  
  </div>

  <div class="col-md-12">
    <div class="form-group">
      <label>Description</label>
      <%= text_area_tag "managesection[content][blocks][#{i}][description]", nil, class:"form-control" %>
    </div>
  </div>
  <hr>
</div>

<% end %>