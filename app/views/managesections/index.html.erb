<div class="container" style="margin-top:30px;">
<%= link_to 'Create Section', new_managesection_path, class: "btn btn-primary pull-right" %>
  <div class="panel panel-default">
    <div class="panel-heading">
      <h3 class="panel-title">
        <i class="fa fa-list"></i> Manage Sections
      </h3>
      
      

    </div>

    <div class="panel-body table-responsive">

      <table class="table table-striped table-bordered table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Section Type</th>
            <th>Title</th>
            <th>Status</th>
            <th width="220">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @sections.each_with_index do |section, index| %>
            <tr id="section_<%= section.id %>">
              <td><%= index + 1 %></td>

              <td>
                <strong><%= section.section_type.titleize %></strong>
              </td>

              <td><%= section.title %></td>

              <td>
                <% if section.active? %>
                  <span class="label label-success">Active</span>
                <% else %>
                  <span class="label label-default">Inactive</span>
                <% end %>
              </td>

              <td>
                <!-- View -->
                <%= link_to managesection_path(section),
                            class: "btn btn-info btn-xs" do %>
                  <i class="fa fa-eye"></i>
                <% end %>

                <!-- Edit -->
                <%= link_to edit_managesection_path(section),
                            class: "btn btn-warning btn-xs" do %>
                  <i class="fa fa-pencil"></i>
                <% end %>

                <!-- Delete -->
                <%= link_to managesection_path(section),
                            method: :delete,
                            remote:true,
                            data: { confirm: "Are you sure?" },
                            class: "btn btn-danger btn-xs" do %>
                  <i class="fa fa-trash"></i>
                <% end %>
              </td>

            </tr>
          <% end %>
        </tbody>

      </table>

    </div>
  </div>

</div>