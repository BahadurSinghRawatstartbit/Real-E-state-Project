<nav class="navbar navbar-default">
  <div class="container">

    <!-- Brand and toggle -->
    <div class="navbar-header">
      <button type="button"
              class="navbar-toggle collapsed"
              data-toggle="collapse"
              data-target="#navigation">
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>

      <%= link_to image_tag("logo.png", alt: "Logo"),
                  root_path,
                  class: "navbar-brand" %>
    </div>

    <!-- Navigation -->
    <div class="collapse navbar-collapse yamm" id="navigation">

      <!-- Right buttons -->
      <div class="button navbar-right btnlog">
        <% if logged_in? %>
          <div class="logoutbtn">
            <%= button_to "Logout",
                          logout_path,
                          method: :delete,
                          data: { confirm: "Are you sure?" },
                          class: "nav-link navbar-btn nav-button wow bounceInRight login" %>
          </div>

          <%# <button class="navbar-btn nav-button wow fadeInRight"
                  onclick="window.print()"
                  data-wow-delay="0.48s"> Submit
          </button> %>
          

          <%# <%= link_to root_path do %> 
                <%# <%= image_tag "carts.png" ,class:"productcart  wow fadeInRight"%> 
                
            <%# <% end %> 
            <% if current_cart.present? %>
                <%= link_to book_path(current_cart), class: "cart-link" do %>
                    <%= image_tag "carts.png", class: "productcart wow fadeInRight" %>
                    <span class="cart-count wow fadeInRight">
                    <%= current_cart.booking_items.count %>
                    </span>
                <% end %>
            <% end %>
        


            
        <% else %>
          <%= link_to "Log in",
                      login_path,
                      class: "navbar-btn nav-button wow bounceInRight login" %>

          <%= link_to "Signup",
                      signup_path,
                      class: "navbar-btn nav-button wow fadeInRight" %>
        <% end %>
      </div>

      <!-- Menu -->
      <ul class="main-nav nav navbar-nav navbar-right" id="myDIV">

        <li class="myli <%= 'active' if current_page?(root_path) %>">
          <%= link_to "Home", root_path %>
        </li>

        <li class="myli <%= 'active' if current_page?(properties_path) %>">
          <%= link_to "Properties", properties_path %>
        </li>

        <li class="myli <%= 'active' if current_page?(your_property_index_path) %>">
          <%= link_to "Wishlist", your_property_index_path %>
        </li>

        <!-- Mega dropdown -->
        <li class="dropdown yamm-fw">
          <a href="#"
             class="dropdown-toggle"
             data-toggle="dropdown"
             data-hover="dropdown">
            Explore More <b class="caret"></b>
          </a>

          <ul class="dropdown-menu">
            <li>
              <div class="yamm-content">
                
                  <div class="col-sm-3 mydata">
                    <h5>User account</h5>
                    <ul>
                      
                      <% if current_user %>
                      <li><%= link_to "Your profile", edit_user_path(current_user.id) %></li>
                      <li><%= link_to "Your order", order_path %></li>
                      <li><%= link_to "Reset your Password", change_password_path %></li>
                      <% else %>
                      <li><%= link_to "Register / Login", login_path %></li>
                      <% end %>
                      
                      
                    </ul>
                  </div>

                
              </div>
            </li>
          </ul>
        </li>

        <li class="myli <%= 'active' if current_page?(pages_contact_path) %>">
          <%= link_to "Contact", pages_contact_path %>
        </li>

        <li class="myli <%= 'active' if current_page?(messages_path) %>">
          <%= link_to "Chat", messages_path %>
        </li>

      </ul>
    </div>
  </div>
</nav>
