<div class="container">
  <div class="row">
    <div class="col-md-8 col-md-offset-2">

      <div class="panel panel-warning" >
        <div class="panel-heading text-center" style="background:#FDC600">
          <h4>Edit FAQ</h4>
        </div>

        <div class="panel-body">
          <%# <%= form_for @faq do |f| %> 
          <%= form_with model: @faq, local: false,html: { multipart: true } do |f| %>

            <div class="form-group">
              <%= f.label :category, "Category" %>
               <%= f.select :category,
              
                    options_for_select([
                      ["For Villa", "villa"],
                      ["For Flats", "flats"],
                      ["For 2 Stories", "2_stories"],
                      ["For more than 2 Stories", "more_than_2"]
                    ]),
                    { prompt: "Please select..." },
                    { class: "form-control" } %>
            </div>

            <div class="form-group">
              <%= f.label :question %>
              <%= f.text_field :question, class: "form-control" %>
            </div>

            <div class="form-group">
              <%= f.label :answer %>
              <%= f.text_area :answer, rows: 5, class: "form-control" %>
            </div>

            <div class="text-center">
              <%= f.submit "Update FAQ", class: "btn btn-success btn-lg" %>
              

          <% end %>
        </div>
        
      </div>

    </div>
    <%= link_to "Back", faqs_path, class: "btn btn-default btn-lg" %>
            </div>
  </div>
</div>