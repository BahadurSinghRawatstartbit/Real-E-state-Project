
<div class="page-head"> 
            <div class="container">
                <div class="row">
                    <div class="page-head-content">
                        <h1 class="page-title text-center">Agent Customer List</h1>               
                    </div>
                </div>
            </div>
        </div>



<div class="container" style="margin-top:50px;">
  

  
  <table class="table table-bordered table-striped">
    <tr>
      <th>CustomerName</th><th>Email</th><th>Property</th>
    </tr>
    <% @agent_customer_list.each do |item| %>
  <tr>
    <td><%= item.book.user.name %></td>
    <td><%= item.book.user.email %></td>
    <td><%= item.property.name %></td>
  </tr>
<% end %>
  </table>

</div>


  